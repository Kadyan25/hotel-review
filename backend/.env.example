# Local dev default matches docker-compose.yml's postgres service.
# On Railway, set this to the Railway Postgres service's connection string
# (with the +asyncpg dialect prefix: postgresql+asyncpg://...).
DATABASE_URL=postgresql+asyncpg://azzurro:azzurro@localhost:5437/azzurro_reviews

# Optional. Leave blank to run keyword-only classification.
ANTHROPIC_API_KEY=

# Optional. Leave blank to skip the Apify scraper fallback.
APIFY_API_TOKEN=

# Cost/safety caps -- see architecture.md "Integrations" for reasoning.
ENABLE_LLM_CLASSIFICATION=false
MAX_LLM_CLASSIFICATIONS=50
MAX_REVIEWS_PER_PROPERTY_APIFY=500

# Session pacing cap for the Playwright/Patchright scraper -- stops a run
# after this many pages per property even if more reviews remain, so a
# single session doesn't nonstop-churn (looks robotic). Rest is picked up
# on a later run via the newest-first incremental design.
SCRAPE_MAX_PAGES_PER_RUN=15

# Only fetch reviews from the last N days while building/demoing -- fewer
# requests per run (lower block risk), smaller dataset, bounds LLM
# classification volume for free. Ignored if SCRAPE_FULL_HISTORY=true.
SCRAPE_LOOKBACK_DAYS=30

# Deliberate opt-in for a full historical backfill run (e.g. Surry Hills
# has 220 pages of history) -- not part of the build/demo path, flip this
# on later as its own one-time job.
SCRAPE_FULL_HISTORY=false

# Headless by default -- Patchright specifically neutralizes the
# headless-detection markers this would otherwise expose, so it's a safe
# default, not a compromise. Set to false only when running from a machine
# with a real interactive desktop session if you want to watch it work.
SCRAPE_HEADLESS=true

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173
