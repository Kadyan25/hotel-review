# Local dev default matches docker-compose.yml's postgres service.
# On Railway, set this to the Railway Postgres service's connection string
# (with the +asyncpg dialect prefix: postgresql+asyncpg://...).
DATABASE_URL=postgresql+asyncpg://azzurro:azzurro@localhost:5437/azzurro_reviews

# Optional. Leave blank to run keyword-only classification.
ANTHROPIC_API_KEY=

# Optional. Leave blank to skip the Apify scraper fallback.
APIFY_API_TOKEN=

# Cost/safety caps -- see architecture.md "Integrations" for reasoning.
ENABLE_LLM_CLASSIFICATION=false
MAX_LLM_CLASSIFICATIONS=50
MAX_REVIEWS_PER_PROPERTY_APIFY=500

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173
